"""Bronze ingestion job for the DynamoDB -> Firehose -> S3 source pattern.

Streams gzipped JSON files from S3 into an existing Delta table, storing each
record in a single VARIANT column alongside load metadata. The job never
creates the target table and fails if the table does not exist.

{% if job.execution_mode == "continuous" %}
The stream runs until it is stopped or fails.
{% else %}
Each run processes the files not yet seen by the checkpoint, then exits.
{% endif %}

Typical usage:

    bronze --env dev
"""

import logging
from dataclasses import dataclass
from functools import partial

from pyspark.sql import DataFrame, SparkSession
from pyspark.sql import functions as F
from pyspark.sql.streaming import StreamingQuery

from {{ package }}.cli import parse_args
from {{ package }}.env import resolve_env
from {{ package }}.logs import configure_logging

# Values from the pipeline YAML.
SOURCE_PATH = {{ bronze.source_path | py_string }}
CHECKPOINT_PATH = {{ bronze.checkpoint_path | py_string }}
TARGET_TABLE = {{ bronze.target_table | py_string }}
{% if job.execution_mode == "continuous" %}
TRIGGER_INTERVAL = {{ bronze.trigger_interval | py_string }}
{% endif %}

VARIANT_COLUMN = "data"

logger = logging.getLogger(__name__)


@dataclass(frozen=True, slots=True)
class BronzeConfig:
    """Resolved settings for a bronze job run.

    Attributes:
        source_path: S3 URL to read source files from.
        checkpoint_path: S3 URL of the streaming checkpoint.
        target_table: Fully qualified name of the target table.
    """

    source_path: str
    checkpoint_path: str
    target_table: str


def build_config(env: str) -> BronzeConfig:
    """Builds the settings for a job run.

    Args:
        env: Deployment environment.

    Returns:
        The resolved job settings.
    """
    return BronzeConfig(
        source_path=resolve_env(SOURCE_PATH, env),
        checkpoint_path=resolve_env(CHECKPOINT_PATH, env),
        target_table=resolve_env(TARGET_TABLE, env),
    )


def ensure_table_exists(spark: SparkSession, table_name: str) -> None:
    """Fails fast when the target table does not exist.

    Args:
        spark: Active Spark session.
        table_name: Fully qualified name of the table to check.

    Raises:
        ValueError: If the table does not exist.
    """
    if not spark.catalog.tableExists(table_name):
        raise ValueError(f"Target table does not exist: {table_name}")


def read_source(spark: SparkSession, source_path: str) -> DataFrame:
    """Creates a streaming read of the source files with Auto Loader.

    Args:
        spark: Active Spark session.
        source_path: S3 URL to read source files from.

    Returns:
        A streaming DataFrame with one VARIANT column.
    """
    return (
        spark.readStream.format("cloudFiles")
        .option("cloudFiles.format", "json")
        .option("pathGlobFilter", "*.gz")
        .option("singleVariantColumn", VARIANT_COLUMN)
        .schema(f"{VARIANT_COLUMN} VARIANT")
        .load(source_path)
    )


def add_load_metadata(df: DataFrame) -> DataFrame:
    """Adds the ingestion time and source file metadata columns.

    File metadata must be selected on the streaming DataFrame because Spark
    does not include it when it is referenced only inside `foreachBatch`.

    Args:
        df: Streaming DataFrame read from the source files.

    Returns:
        The DataFrame with `_ingested_at`, `_file_path`, and
        `_file_modification_time` columns added.
    """
    return df.select(
        VARIANT_COLUMN,
        F.current_timestamp().alias("_ingested_at"),
        F.col("_metadata.file_path").alias("_file_path"),
        F.col("_metadata.file_modification_time").alias("_file_modification_time"),
    )


def append_batch(
    batch_df: DataFrame,
    epoch_id: int,
    target_table: str,
    checkpoint_path: str,
) -> None:
    """Appends a microbatch to the target table.

    `DataFrameWriterV2.append` fails if the table is missing, so a table dropped
    during a run is not recreated. The transaction options make a replayed batch
    a no-op, which keeps delivery exactly-once for this table.

    Args:
        batch_df: Records in the microbatch.
        epoch_id: Spark's batch number, unique within the checkpoint.
        target_table: Fully qualified name of the target table.
        checkpoint_path: Streaming checkpoint path, used as the transaction
            application ID.
    """
    (
        batch_df.writeTo(target_table)
        .option("txnAppId", checkpoint_path)
        .option("txnVersion", str(epoch_id))
        .append()
    )


def write_batch(
    batch_df: DataFrame,
    epoch_id: int,
    target_table: str,
    checkpoint_path: str,
) -> None:
    """Writes one microbatch and logs its read and written record counts.

    The microbatch is persisted so counting and writing it do not each read the
    source files. The written count is the number of records appended, so a replayed
    batch that Delta skips is still counted.

    Args:
        batch_df: Records in the microbatch.
        epoch_id: Spark's batch number, unique within the checkpoint.
        target_table: Fully qualified name of the target table.
        checkpoint_path: Streaming checkpoint path, used as the transaction
            application ID.
    """
    batch_df.persist()
    try:
        records_read = batch_df.count()
        if records_read > 0:
            append_batch(batch_df, epoch_id, target_table, checkpoint_path)
    finally:
        batch_df.unpersist()

    logger.info(
        "Processed microbatch",
        extra={
            "epoch_id": epoch_id,
            "target_table": target_table,
            "records_read": records_read,
            "records_written": records_read,
        },
    )


def start_stream(df: DataFrame, config: BronzeConfig) -> StreamingQuery:
    """Starts the streaming write to the target table.

    Args:
        df: Streaming DataFrame to write.
        config: Resolved job settings.

    Returns:
        The running streaming query.
    """
    return (
{% if job.execution_mode == "continuous" %}
        df.writeStream.trigger(processingTime=TRIGGER_INTERVAL)
{% else %}
        df.writeStream.trigger(availableNow=True)
{% endif %}
        .option("checkpointLocation", config.checkpoint_path)
        .foreachBatch(
            partial(
                write_batch,
                target_table=config.target_table,
                checkpoint_path=config.checkpoint_path,
            )
        )
        .start()
    )


def main() -> None:
    """Runs the bronze ingestion job until the stream finishes or fails."""
    configure_logging()
    args = parse_args("Run a bronze ingestion job.")
    config = build_config(args.env)

    spark = SparkSession.builder.getOrCreate()
    spark.conf.set("spark.sql.session.timeZone", "UTC")

    ensure_table_exists(spark, config.target_table)

    df = add_load_metadata(read_source(spark, config.source_path))
    query = start_stream(df, config)
    logger.info(
        "Started stream",
        extra={"query_id": str(query.id), "target_table": config.target_table},
    )
    query.awaitTermination()


if __name__ == "__main__":
    main()
