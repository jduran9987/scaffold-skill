"""Gold job for the DynamoDB -> Firehose -> S3 source pattern.

Streams change events from the silver table, keeps the latest event per primary key
within each microbatch, and merges the result into an existing Delta table so it
holds the latest record for each primary key. The job never creates the target table
and fails if the table does not exist.

{% if job.execution_mode == "continuous" %}
The stream runs until it is stopped or fails.
{% else %}
Each run processes the silver records not yet seen by the checkpoint, then exits.
{% endif %}

Typical usage:

    gold --env dev
"""

import logging
from dataclasses import dataclass
from functools import partial

from pyspark.sql import DataFrame, SparkSession, Window
from pyspark.sql import functions as F
from pyspark.sql.streaming import StreamingQuery

from {{ package }}.cli import parse_args
from {{ package }}.env import resolve_env
from {{ package }}.logs import configure_logging

# Values from the pipeline YAML.
SOURCE_TABLE = {{ silver.target_table | py_string }}
CHECKPOINT_PATH = {{ gold.checkpoint_path | py_string }}
TARGET_TABLE = {{ gold.target_table | py_string }}
{% if job.execution_mode == "continuous" %}
TRIGGER_INTERVAL = {{ gold.trigger_interval | py_string }}
{% endif %}
PRIMARY_KEYS = (
{% for key in primary_keys %}
    {{ key | py_string }},
{% endfor %}
)
UPSERT_LATEST_KEY = {{ gold.upsert_latest_key | py_string }}

ROW_NUMBER_COLUMN = "_row_number"
BATCH_VIEW = "_gold_microbatch"

logger = logging.getLogger(__name__)


@dataclass(frozen=True, slots=True)
class GoldConfig:
    """Resolved settings for a gold job run.

    Attributes:
        source_table: Fully qualified name of the silver table.
        checkpoint_path: S3 URL of the streaming checkpoint.
        target_table: Fully qualified name of the target table.
    """

    source_table: str
    checkpoint_path: str
    target_table: str


@dataclass(frozen=True, slots=True)
class MergeCounts:
    """Rows a merge changed in the target table.

    Attributes:
        inserted: Rows inserted for new primary keys.
        updated: Existing rows replaced by a later record.
    """

    inserted: int
    updated: int


def build_config(env: str) -> GoldConfig:
    """Builds the settings for a job run.

    Args:
        env: Deployment environment.

    Returns:
        The resolved job settings.
    """
    return GoldConfig(
        source_table=resolve_env(SOURCE_TABLE, env),
        checkpoint_path=resolve_env(CHECKPOINT_PATH, env),
        target_table=resolve_env(TARGET_TABLE, env),
    )


def ensure_table_exists(spark: SparkSession, table_name: str) -> None:
    """Fails fast when the target table does not exist.

    Args:
        spark: Active Spark session.
        table_name: Fully qualified name of the table to check.

    Raises:
        ValueError: If the table does not exist.
    """
    if not spark.catalog.tableExists(table_name):
        raise ValueError(f"Target table does not exist: {table_name}")


def read_source(spark: SparkSession, source_table: str) -> DataFrame:
    """Creates a streaming read of the silver table.

    Args:
        spark: Active Spark session.
        source_table: Fully qualified name of the silver table.

    Returns:
        A streaming DataFrame of silver records.
    """
    return spark.readStream.table(source_table)


def deduplicate_batch(batch_df: DataFrame) -> DataFrame:
    """Keeps the record with the latest upsert key for each primary key.

    MERGE fails when two source rows match the same target row, so each primary
    key must appear once. Records with a NULL upsert key sort last.

    Args:
        batch_df: Silver records in the microbatch.

    Returns:
        One record per primary key.
    """
    window = Window.partitionBy(*PRIMARY_KEYS).orderBy(
        F.col(UPSERT_LATEST_KEY).desc_nulls_last()
    )
    return (
        batch_df.withColumn(ROW_NUMBER_COLUMN, F.row_number().over(window))
        .where(F.col(ROW_NUMBER_COLUMN) == 1)
        .drop(ROW_NUMBER_COLUMN)
    )


def quote_identifier(name: str) -> str:
    """Quotes a column name for Spark SQL.

    Args:
        name: Column name.

    Returns:
        The name wrapped in backticks.
    """
    return f"`{name}`"


def build_merge_statement(target_table: str, source_view: str) -> str:
    """Builds the MERGE that upserts a microbatch into the target table.

    Rows match on every primary key column. A matched row is replaced only when the
    incoming upsert key is at least as recent as the stored one, so an older record
    never overwrites a newer one and a replayed batch leaves the table unchanged.

    Args:
        target_table: Fully qualified name of the target table.
        source_view: Name of the view holding the deduplicated microbatch.

    Returns:
        The MERGE statement.
    """
    match_condition = " AND ".join(
        f"t.{quote_identifier(key)} <=> s.{quote_identifier(key)}"
        for key in PRIMARY_KEYS
    )
    latest = quote_identifier(UPSERT_LATEST_KEY)
    return (
        f"MERGE INTO {target_table} AS t USING {source_view} AS s "
        f"ON {match_condition} "
        f"WHEN MATCHED AND s.{latest} >= t.{latest} THEN UPDATE SET * "
        "WHEN NOT MATCHED THEN INSERT *"
    )


def merge_batch(batch_df: DataFrame, target_table: str) -> MergeCounts:
    """Merges a deduplicated microbatch into the target table.

    The MERGE fails if the target table is missing, so a table dropped during a run
    is not recreated.

    Args:
        batch_df: One record per primary key.
        target_table: Fully qualified name of the target table.

    Returns:
        The rows the merge inserted and updated.
    """
    batch_df.createOrReplaceTempView(BATCH_VIEW)
    metrics = batch_df.sparkSession.sql(
        build_merge_statement(target_table, BATCH_VIEW)
    ).first()
    return MergeCounts(
        inserted=int(metrics["num_inserted_rows"]),
        updated=int(metrics["num_updated_rows"]),
    )


def write_batch(batch_df: DataFrame, epoch_id: int, target_table: str) -> None:
    """Deduplicates and merges one microbatch, then logs its record counts.

    The microbatch is persisted so counting, deduplicating, and merging it do not
    each read the source table.

    Args:
        batch_df: Silver records in the microbatch.
        epoch_id: Spark's batch number, unique within the checkpoint.
        target_table: Fully qualified name of the target table.
    """
    batch_df.persist()
    try:
        records_read = batch_df.count()
        counts = MergeCounts(inserted=0, updated=0)
        if records_read > 0:
            counts = merge_batch(deduplicate_batch(batch_df), target_table)
    finally:
        batch_df.unpersist()

    logger.info(
        "Processed microbatch",
        extra={
            "epoch_id": epoch_id,
            "target_table": target_table,
            "records_read": records_read,
            "records_inserted": counts.inserted,
            "records_updated": counts.updated,
        },
    )


def start_stream(df: DataFrame, config: GoldConfig) -> StreamingQuery:
    """Starts the streaming merge into the target table.

    Args:
        df: Streaming DataFrame to merge.
        config: Resolved job settings.

    Returns:
        The running streaming query.
    """
    return (
{% if job.execution_mode == "continuous" %}
        df.writeStream.trigger(processingTime=TRIGGER_INTERVAL)
{% else %}
        df.writeStream.trigger(availableNow=True)
{% endif %}
        .option("checkpointLocation", config.checkpoint_path)
        .foreachBatch(partial(write_batch, target_table=config.target_table))
        .start()
    )


def main() -> None:
    """Runs the gold job until the stream finishes or fails."""
    configure_logging()
    args = parse_args("Run a gold job.")
    config = build_config(args.env)

    spark = SparkSession.builder.getOrCreate()
    spark.conf.set("spark.sql.session.timeZone", "UTC")

    ensure_table_exists(spark, config.target_table)

    query = start_stream(read_source(spark, config.source_table), config)
    logger.info(
        "Started stream",
        extra={"query_id": str(query.id), "target_table": config.target_table},
    )
    query.awaitTermination()


if __name__ == "__main__":
    main()
