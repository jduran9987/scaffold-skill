bundle:
  name: {{ metadata.name }}
  engine: direct

include:
  - resource/*.yml

artifacts:
  {{ metadata.name | replace("-", "_") }}_wheel:
    type: whl
    build: uv build --wheel
    path: .

{% set prod = bundle.targets[notification_target] %}
variables:
  environment:
    description: Environment name that replaces {env} in task paths and table names.
  compute_policy_id:
    description: ID of the cluster policy the tasks' compute uses.
  run-as:
    description: Application ID of the service principal the job runs as.
{% if prod.on_job_failure_webhook_notification_ids %}
  job_failure_webhooks:
    description: Notification destinations the job alerts when a run fails. Set only by prod.
    type: complex
    default: []
{% endif %}
{% if prod.on_job_failure_emails %}
  job_failure_emails:
    description: Addresses the job emails when a run fails. Set only by prod.
    type: complex
    default: []
{% endif %}
{% if prod.on_task_failure_webhook_notification_ids %}
  task_failure_webhooks:
    description: Notification destinations each task alerts when it fails. Set only by prod.
    type: complex
    default: []
{% endif %}
{% if prod.on_task_failure_emails %}
  task_failure_emails:
    description: Addresses each task emails when it fails. Set only by prod.
    type: complex
    default: []
{% endif %}

targets:
{% for name, target in bundle.targets.items() %}
  {{ name }}:
    mode: production
    workspace:
      host: {{ target.host | yaml_string }}
      root_path: /Workspace/Users/${var.run-as}/.bundle/${bundle.name}/${bundle.target}
    variables:
      environment: {{ name }}
      compute_policy_id: {{ target.compute_policy | yaml_string }}
      run-as:
        lookup:
          service_principal: {{ target.service_principal | yaml_string }}
{% if target.on_job_failure_webhook_notification_ids %}
      job_failure_webhooks:
{% for webhook_id in target.on_job_failure_webhook_notification_ids %}
        - id: {{ webhook_id | yaml_string }}
{% endfor %}
{% endif %}
{% if target.on_job_failure_emails %}
      job_failure_emails:
{% for email in target.on_job_failure_emails %}
        - {{ email | yaml_string }}
{% endfor %}
{% endif %}
{% if target.on_task_failure_webhook_notification_ids %}
      task_failure_webhooks:
{% for webhook_id in target.on_task_failure_webhook_notification_ids %}
        - id: {{ webhook_id | yaml_string }}
{% endfor %}
{% endif %}
{% if target.on_task_failure_emails %}
      task_failure_emails:
{% for email in target.on_task_failure_emails %}
        - {{ email | yaml_string }}
{% endfor %}
{% endif %}
    run_as:
      service_principal_name: "${var.run-as}"
{% if not target.permissions.is_empty() %}
    permissions:
{% for level, grantees in target.permissions.levels().items() %}
{% for _ in grantees.service_principal %}
      - service_principal_name: "${var.run-as}"
        level: {{ level }}
{% endfor %}
{% for group in grantees.groups %}
      - group_name: {{ group | yaml_string }}
        level: {{ level }}
{% endfor %}
{% endfor %}
{% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}
