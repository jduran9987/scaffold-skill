version: v1

{% macro value_or_required(value) %}{{ value | yaml_string }}{% if not value %}  # {{ required }}{% endif %}{% endmacro %}
metadata:
  name: {{ value_or_required(name) }}
  description: ""  # {{ required }}
  pythonVersion: {{ python_version | yaml_string }}
  uvBuildVersion: {{ uv_build_version | yaml_string }}

bundle:
  tags:
{% for key, value in bundle.tags.items() %}
    {{ key }}: {{ value | yaml_string }}
{% endfor %}
  targets:
{% for name, target in bundle.targets.items() %}
    - {{ name }}:
        host: {{ target.host | yaml_string }}
        servicePrincipal: {{ target.service_principal | yaml_string }}
        computePolicy: {{ target.compute_policy | yaml_string }}
        servicePrincipalPermissions: {{ target.service_principal_permissions | yaml_string }}
{% for key, groups in [
  ("manageGroups", target.manage_groups),
  ("runGroups", target.run_groups),
  ("viewGroups", target.view_groups),
] %}
{% if groups %}
        {{ key }}:
{% for group in groups %}
          - {{ group | yaml_string }}
{% endfor %}
{% else %}
        {{ key }}: []
{% endif %}
{% endfor %}
{% if name == notification_target %}
        # Only prod accepts failure notifications. Remove any you don't want sent.
{% for key, values in [
  ("onJobFailureWebhookNotificationIds", notification_defaults.on_job_failure_webhook_notification_ids),
  ("onJobFailureEmails", notification_defaults.on_job_failure_emails),
  ("onTaskFailureWebhookNotificationIds", notification_defaults.on_task_failure_webhook_notification_ids),
  ("onTaskFailureEmails", notification_defaults.on_task_failure_emails),
] if values %}
        {{ key }}:
{% for value in values %}
          - {{ value | yaml_string }}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}

job:
  executionMode: {{ execution_mode | yaml_string }}
{% if execution_mode == "batch" %}
  batchSchedule: ""  # {{ required }}
{% else %}
  # batchSchedule: {{ sample_batch_schedule | yaml_string }}  # {{ batch_only }}
{% endif %}
  bronze:
    sourcePath: ""  # {{ required }}
    checkpointPath: {{ value_or_required(layers.bronze.checkpoint_path) }}
    targetTable: {{ value_or_required(layers.bronze.target_table) }}
    {{ "# " if execution_mode == "batch" else "" }}triggerInterval: {{ trigger_interval | yaml_string }}  # {{ continuous_only }}
  silver:
    checkpointPath: {{ value_or_required(layers.silver.checkpoint_path) }}
    targetTable: {{ value_or_required(layers.silver.target_table) }}
    {{ "# " if execution_mode == "batch" else "" }}triggerInterval: {{ trigger_interval | yaml_string }}  # {{ continuous_only }}
  gold:
    upsertLatestKey: {{ upsert_latest_key | yaml_string }}
    checkpointPath: {{ value_or_required(layers.gold.checkpoint_path) }}
    targetTable: {{ value_or_required(layers.gold.target_table) }}
    {{ "# " if execution_mode == "batch" else "" }}triggerInterval: {{ trigger_interval | yaml_string }}  # {{ continuous_only }}

schema:
  columns:
{% for column in schema.columns %}
    - name: {{ column.name | yaml_string }}
      description: {{ description_placeholder | yaml_string }}
      dynamoType: {{ column.dynamo_type | yaml_string }}
      targetType: ""  # {{ required }}
      path: {{ column.path | yaml_string }}
      key: {{ "true" if column.key else "false" }}
{% endfor %}
  primaryKeys:
{% for key in schema.primary_keys %}
    - {{ key | yaml_string }}
{% endfor %}
