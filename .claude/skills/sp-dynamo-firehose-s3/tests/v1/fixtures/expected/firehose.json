{
  "DeliveryStreamName": "orders-firehose",
  "DeliveryStreamType": "KinesisStreamAsSource",
  "KinesisStreamSourceConfiguration": {
    "KinesisStreamARN": "arn:aws:kinesis:us-east-1:123456789012:stream/orders",
    "RoleARN": "arn:aws:iam::123456789012:role/firehose_delivery_role"
  },
  "ExtendedS3DestinationConfiguration": {
    "BucketARN": "arn:aws:s3:::dev-drivewealth-kinesis",
    "Prefix": "firehose-stream/!{partitionKeyFromQuery:tableName}/!{timestamp:yyyy/MM/dd/HH}/",
    "ErrorOutputPrefix": "firehose-stream/failures/orders/!{firehose:error-output-type}/!{timestamp:yyyy/MM/dd/HH}/",
    "BufferingHints": {
      "SizeInMBs": 128,
      "IntervalInSeconds": 300
    },
    "CompressionFormat": "GZIP",
    "DynamicPartitioningConfiguration": {
      "Enabled": true,
      "RetryOptions": {
        "DurationInSeconds": 60
      }
    },
    "ProcessingConfiguration": {
      "Enabled": true,
      "Processors": [
        {
          "Type": "MetadataExtraction",
          "Parameters": [
            {
              "ParameterName": "MetadataExtractionQuery",
              "ParameterValue": "{tableName:limit(1;.tableName | gsub(\"\\\\.\", \"-\"; \"-\"))}"
            },
            {
              "ParameterName": "JsonParsingEngine",
              "ParameterValue": "JQ-1.6"
            }
          ]
        },
        {
          "Type": "AppendDelimiterToRecord",
          "Parameters": [
            {
              "ParameterName": "Delimiter",
              "ParameterValue": "\\n"
            }
          ]
        }
      ]
    },
    "RoleARN": "arn:aws:iam::123456789012:role/firehose_delivery_role"
  }
}
